{
  "name": "nivra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-backup-cli.mjs && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "postinstall": "node scripts/patch-csp.mjs && node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs && node scripts/build-processing-worker.mjs && node scripts/build-public-reader.mjs",
    "predev": "node scripts/copy-assets.mjs && node scripts/build-processing-worker.mjs && node scripts/build-public-reader.mjs",
    "format": "prettier --write src tests scripts docs *.md *.json *.ts *.mjs .github/workflows/*.yml docker-compose.yaml",
    "format:check": "prettier --check src tests scripts docs *.md *.json *.ts *.mjs .github/workflows/*.yml docker-compose.yaml",
    "backup": "tsx scripts/backup-cli.ts",
    "verify:branding": "node scripts/verify-branding.mjs",
    "pretest": "node scripts/build-processing-worker.mjs && node scripts/build-public-reader.mjs",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "verify:api": "tsx scripts/generate-openapi.ts --check && tsx scripts/verify-api.ts",
    "ai:assets": "node scripts/fetch-ai-model.mjs"
  },

---
import "../styles/site.css";
const base = import.meta.env.BASE_URL;
const asset = (name: string) => `${base}${name}`;
const repository = "https://github.com/Harsh-2002/Nivra";
const workflows = [
  {
    id: "notes",
    label: "Write",
    title: "Give an idea somewhere to grow.",
    copy: "A quick thought, a daily journal, a page with room to think. Keep your writing, drawings and references together.",
    alt: "Nivra note editor showing the field guide project brief, with headings and a reading shelf.",
  },
  {
    id: "board",
    label: "Plan",
    title: "Put the next step in view.",
    copy: "Turn a thought into a task. Move it across your board, give it a date, and find it on your calendar.",
    alt: "Nivra Kanban board with real demonstration tasks in To do, In progress and Done.",
  },
  {
    id: "calendar",
    label: "Make time",
    title: "A little room for what matters.",
    copy: "See your tasks and events in one calendar. Link a note to a plan, and let a reminder bring you back to it.",
    alt: "Nivra October calendar showing writing sessions, tasks and a coastal walk.",
  },
  {
    id: "forms",
    label: "Collect",
    title: "Make space for other perspectives.",
    copy: "Build a simple form, share it publicly, and keep the responses in your workspace. Export them when you need to.",
    alt: "Nivra form builder showing a feedback form with name, email, choice and written answer fields.",
  },
];
const connectedFeatures = [
  {
    id: "smart-tags",
    title: "Smart tagging",
    copy:
      "Start with the tags you already use. Match new work to your tags first. " +
      "Review suggestions, or opt into automatic tagging for recurring topics.",
    window: "Tags",
    alt: "Nivra showing a suggested tag alongside the item it can organize.",
  },
  {
    id: "semantic-search",
    title: "Semantic search",
    copy:
      "Search by the idea you remember. Find related notes and files even when " +
      "your words differ, including OCR and document text.",
    window: "Search",
    alt: "Nivra search results for a natural-language query, showing related workspace items.",
  },
];
const command =
  "docker run -d --name nivra \\\n  --restart unless-stopped --init \\\n  -p 3000:3000 \\\n  -v nivra-data:/app/data \\\n  ghcr.io/harsh-2002/nivra:latest";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101011"
      media="(prefers-color-scheme: dark)"
    />
    <title>Nivra — Your thoughts, together.</title>
    <meta
      name="description"
      content="A quiet, self-hosted workspace for your notes, journals, tasks, bookmarks and files. Write, plan and keep the things that matter together."
    />
    <link rel="canonical" href="https://harsh-2002.github.io/Nivra/" />
    <link rel="icon" href={asset("icon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      href={asset("fonts/geist-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Nivra — Your thoughts, together." />
    <meta
      property="og:description"
      content="A quiet workspace for your notes, plans and ideas. Open source. Self-hosted. Yours."
    />
    <meta property="og:url" content="https://harsh-2002.github.io/Nivra/" />
    <meta
      property="og:image"
      content="https://harsh-2002.github.io/Nivra/social.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("nivra-site-theme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <a class="brand hero-brand" href={base} aria-label="Nivra home">
          <img src={asset("icon.svg")} width="30" height="30" alt="" />
          <span>Nivra</span>
        </a>
        <div class="hero-intro">
          <h1 id="hero-title">
            Your thoughts,
            <br />
            together.
          </h1>
          <div class="hero-detail">
            <p>
              A quiet workspace for your notes, plans and ideas. All connected.
              All on your own server.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#start">
                Self-host Nivra
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
              <a class="text-link" href={repository}>
                View on GitHub
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        <figure class="hero-figure">
          <div class="app-window hero-window">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span class="window-label">Nivra / Overview</span>
              <span class="window-spacer"></span>
            </div>
            {["light", "dark"].map((theme) => (
              <picture class={`theme-image ${theme}-image`}>
                <source
                  media="(max-width: 600px)"
                  srcset={asset(`screenshots/overview-mobile-${theme}.webp`)}
                />
                <img
                  src={asset(`screenshots/overview-${theme}.webp`)}
                  srcset={`${asset(`screenshots/overview-${theme}-960.webp`)} 960w, ${asset(`screenshots/overview-${theme}.webp`)} 1920w`}
                  sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px"
                  width="1440"
                  height="900"
                  fetchpriority="high"
                  alt="Nivra Overview showing a personal field guide project, with open tasks, recent notes and saved references."
                />
              </picture>
            ))}
          </div>
          <figcaption>
            One place to return to. Real Nivra screens, with demonstration
            content.
          </figcaption>
        </figure>
      </section>
      <section
        class="product container"
        id="product"
        aria-labelledby="product-title"
      >
        <div class="section-intro">
          <h2 id="product-title">
            From a passing thought
            <br />
            to something real.
          </h2>
          <p>
            Write it down. Find the next step.
            <br />
            Keep the context close.
          </p>
        </div>
        <div
          class="workflow-tabs"
          role="tablist"
          aria-label="Explore Nivra workflows"
        >
          {workflows.map((w, i) => (
            <button
              id={`tab-${w.id}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${w.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-workflow={w.id}
            >
              {w.label}
            </button>
          ))}
        </div>
        {workflows.map((w, i) => (
          <div
            class="workflow-panel"
            id={`panel-${w.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${w.id}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div class="workflow-copy">
              <h3>{w.title}</h3>
              <p>{w.copy}</p>
            </div>
            <div class="app-window workflow-window">
              <div class="window-bar" aria-hidden="true">
                <span class="window-dots">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span class="window-label">
                  Nivra /{" "}
                  {w.id === "board"
                    ? "Kanban"
                    : w.id[0].toUpperCase() + w.id.slice(1)}
                </span>
                <span class="window-spacer"></span>
              </div>
              {["light", "dark"].map((theme) => (
                <picture class={`theme-image ${theme}-image`}>
                  <source
                    media="(max-width: 600px)"
                    srcset={asset(`screenshots/${w.id}-mobile-${theme}.webp`)}
                  />
                  <img
                    src={asset(`screenshots/${w.id}-${theme}.webp`)}
                    srcset={`${asset(`screenshots/${w.id}-${theme}-960.webp`)} 960w, ${asset(`screenshots/${w.id}-${theme}.webp`)} 1920w`}
                    sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px"
                    width="1440"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    alt={w.alt}
                  />
                </picture>
              ))}
            </div>
          </div>
        ))}
      </section>
      <section
        class="connections container"
        id="connections"
        aria-labelledby="connections-title"
      >
        <div class="connections-heading">
          <h2 id="connections-title">Keep the thread.</h2>
          <p>Optional features in preview, shown with demonstration content.</p>
        </div>
        <div class="connections-grid">
          {connectedFeatures.map((feature) => (
            <article class="connection-card">
              <div class="connection-copy">
                <h3>{feature.title}</h3>
                <p>{feature.copy}</p>
              </div>
              <div class="app-window connection-window">
                <div class="window-bar" aria-hidden="true">
                  <span class="window-dots">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                  <span class="window-label">Nivra / {feature.window}</span>
                  <span class="window-spacer"></span>
                </div>
                {(["light", "dark"] as const).map((theme) => (
                  <div class={`theme-image ${theme}-image`}>
                    <a
                      class="connection-image-link"
                      href={asset(`screenshots/${feature.id}-${theme}.webp`)}
                      data-desktop-href={asset(
                        `screenshots/${feature.id}-${theme}.webp`,
                      )}
                      data-mobile-href={asset(
                        `screenshots/${feature.id}-mobile-${theme}.webp`,
                      )}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open full-size ${feature.title} screenshot`}
                    >
                      <picture>
                        <source
                          media="(max-width: 600px)"
                          srcset={asset(
                            `screenshots/${feature.id}-mobile-${theme}.webp`,
                          )}
                        />
                        <img
                          src={asset(`screenshots/${feature.id}-${theme}.webp`)}
                          srcset={`${asset(`screenshots/${feature.id}-${theme}-960.webp`)} 960w, ${asset(`screenshots/${feature.id}-${theme}.webp`)} 1440w`}
                          sizes="(max-width: 600px) calc(100vw - 72px), (max-width: 760px) calc(100vw - 80px), (max-width: 1000px) calc((100vw - 116px) / 2), (max-width: 1219px) calc((100vw - 200px) / 2), 510px"
                          width="1440"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          alt={feature.alt}
                        />
                      </picture>
                    </a>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        class="ownership container"
        id="yours"
        aria-labelledby="ownership-title"
      >
        <div>
          <h2 id="ownership-title">
            A workspace
            <br />
            that stays yours.
          </h2>
          <p>
            Open source, self-hosted, and built for one person.
            <br class="desktop-break" /> A little less noise. A little more room
            to think.
          </p>
        </div>
        <dl class="ownership-list">
          <div>
            <dt>Your server. Your choice.</dt>
            <dd>
              Store files locally or in S3. Choose encryption at rest during
              setup.
            </dd>
          </div>
          <div>
            <dt>Bring your tools along.</dt>
            <dd>
              Connect an AI agent through MCP, with read or read and write
              access.
            </dd>
          </div>
          <div>
            <dt>Keep a way out.</dt>
            <dd>
              Export your work and take full backups. Your workspace is yours to
              keep.
            </dd>
          </div>
        </dl>
      </section>
      <section class="start container" id="start" aria-labelledby="start-title">
        <div class="start-copy">
          <h2 id="start-title">
            Make yourself
            <br />
            some space.
          </h2>
          <p>
            Start Nivra with Docker, then follow the guided setup in your
            browser.
          </p>
          <a class="text-link" href={`${repository}#get-started-with-docker`}>
            Read the quick start
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
        <div class="install">
          <div class="install-heading">
            <span>Docker quick start</span>
            <button
              class="icon-button copy-button"
              type="button"
              aria-label="Copy Docker quick start"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <rect x="8" y="8" width="12" height="12" rx="2" />
                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
              </svg>
            </button>
          </div>
          <pre
            tabindex="0"
            aria-label="Docker installation commands"
          ><code id="install-command">{command}</code></pre>
          <div class="install-footer">
            <span>
              Open <code>localhost:3000</code> to set up your workspace.
            </span>
            <span id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer container">
      <div class="footer-links">
        <a href={repository}>GitHub</a>
        <a href={`${repository}/blob/main/LICENSE`}>MIT license</a>
      </div>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch theme"
      >
        <svg class="moon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" />
        </svg>
        <svg class="sun" aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </footer>
    <script>
      const root = document.documentElement;
      const screenshotViewport = window.matchMedia("(max-width: 600px)");
      const refreshScreenshotLinks = () => {
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          ".connection-image-link",
        )) {
          link.href = screenshotViewport.matches
            ? (link.dataset.mobileHref ?? link.href)
            : (link.dataset.desktopHref ?? link.href);
        }
      };
      refreshScreenshotLinks();
      screenshotViewport.addEventListener("change", refreshScreenshotLinks);
      const preference = window.matchMedia("(prefers-color-scheme: dark)");
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === "dark" : preference.matches;
      const refreshThemeLabel = () =>
        document
          .querySelector(".theme-toggle")
          ?.setAttribute(
            "aria-label",
            `Switch to ${isDark() ? "light" : "dark"} theme`,
          );
      refreshThemeLabel();
      preference.addEventListener("change", refreshThemeLabel);
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        root.dataset.theme = isDark() ? "light" : "dark";
        try {
          localStorage.setItem("nivra-site-theme", root.dataset.theme);
        } catch {}
        refreshThemeLabel();
      });
      const tabs = [
        ...document.querySelectorAll<HTMLButtonElement>("[data-workflow]"),
      ];
      function select(tab: HTMLButtonElement) {
        for (const item of tabs) {
          const active = item === tab;
          item.setAttribute("aria-selected", String(active));
          item.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(
            item.getAttribute("aria-controls")!,
          );
          if (panel) panel.hidden = !active;
        }
      }
      for (const tab of tabs) {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const index = tabs.indexOf(tab);
          let next = index;
          if (e.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (e.key === "ArrowLeft")
            next = (index + tabs.length - 1) % tabs.length;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = tabs.length - 1;
          else return;
          e.preventDefault();
          select(tabs[next]);
          tabs[next].focus();
        });
      }
      document
        .querySelector(".copy-button")
        ?.addEventListener("click", async () => {
          const content =
            document.querySelector("#install-command")?.textContent;
          const status = document.querySelector("#copy-status");
          if (!content || !status) return;
          try {
            await navigator.clipboard.writeText(content);
            status.textContent = "Copied";
          } catch {
            status.textContent = "Select and copy the commands above.";
          }
        });
    </script>
  </body>
</html>

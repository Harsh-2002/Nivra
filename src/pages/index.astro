---
import "../styles/site.css";
const base = import.meta.env.BASE_URL;
const asset = (name: string) => `${base}${name}`;
const repository = "https://github.com/Harsh-2002/Nivra";
const workflowGroups = [
  {
    id: "write",
    label: "Write",
    features: [
      {
        id: "notes",
        label: "Notes",
        title: "Give an idea somewhere to grow.",
        copy: "Keep thoughts, references and drawings together in notes you can return to.",
        alt: "Nivra note editor showing a native pollinator field guide with seasonal care notes.",
      },
      {
        id: "journals",
        label: "Journals",
        title: "Make room for a daily thought.",
        copy: "Keep dated entries close to the notes, plans and moments they belong with.",
        alt: "Nivra journal view showing dated entries and a selected daily reflection.",
      },
      {
        id: "quick",
        label: "Quick",
        title: "Catch a thought before it goes.",
        copy: "Capture a note, task, link or file without losing your place.",
        alt: "Nivra Quick capture view with options for saving a note, task, link or file.",
      },
      {
        id: "drawing",
        label: "Drawings",
        title: "Think on the page.",
        copy: "Sketch ideas and keep diagrams beside the notes they explain.",
        alt: "Nivra drawing canvas with a project diagram and drawing controls.",
      },
      {
        id: "published-note",
        label: "Published notes",
        title: "Share a note when it is ready.",
        copy: "Publish a focused page and give people a simple link to read it.",
        alt: "A published Nivra note displayed as a clean public reading page.",
      },
    ],
  },
  {
    id: "plan",
    label: "Plan",
    features: [
      {
        id: "tasks",
        label: "Tasks",
        title: "Keep the next step close.",
        copy: "Capture tasks, set due dates and keep the open work easy to scan.",
        alt: "Nivra tasks list with open tasks, due dates and completion controls.",
      },
      {
        id: "kanban",
        label: "Kanban",
        title: "See work move forward.",
        copy: "Arrange tasks on a simple board and move each one as work changes.",
        alt: "Nivra Kanban board with demonstration tasks in To do, In progress and Done columns.",
      },
      {
        id: "calendar",
        label: "Calendar",
        title: "Make a little room for what matters.",
        copy: "See dated tasks and events together, with reminders to bring you back.",
        alt: "Nivra calendar with dated tasks and events across the month.",
      },
    ],
  },
  {
    id: "collect",
    label: "Collect",
    features: [
      {
        id: "bookmarks",
        label: "Bookmarks",
        title: "Keep useful links within reach.",
        copy: "Save a page with its title and context, then find it alongside your notes.",
        alt: "Nivra bookmarks view with saved links, collections and page descriptions.",
      },
      {
        id: "artifacts",
        label: "Artifacts",
        title: "Keep files and fragments together.",
        copy: "Save screenshots, documents, text and files in one searchable library.",
        alt: "Nivra artifacts gallery showing document, image, text and file items.",
      },
      {
        id: "forms",
        label: "Forms",
        title: "Make space for other perspectives.",
        copy: "Build a simple form, choose its fields and share it when it is ready.",
        alt: "Nivra form builder showing the Seedling exchange sign-up form with a required name field.",
      },
      {
        id: "public-form",
        label: "Published form",
        title: "Collect responses in one place.",
        copy: "Share a clean public form and keep each response with its supporting files.",
        alt: "Nivra published public form displayed as a simple respondent-facing page.",
      },
      {
        id: "form-responses",
        label: "Responses",
        title: "See what came back.",
        copy: "Review individual submissions, inspect their details and export the results.",
        alt: "Nivra form responses view showing submitted answers and response details.",
      },
      {
        id: "trash",
        label: "Trash",
        title: "A way to bring things back.",
        copy: "Review deleted items from across your workspace and restore what you still need.",
        alt: "Nivra Trash listing deleted items from several workspace sections with restore actions.",
      },
    ],
  },
  {
    id: "connect",
    label: "Connect",
    features: [
      {
        id: "tags",
        label: "Tags",
        title: "Give related work a shared thread.",
        copy: "Use your own tags to gather notes, tasks, journal entries, links and files.",
        alt: "Nivra tags view showing items grouped under an owner-created tag.",
      },
      {
        id: "favorites",
        label: "Favorites",
        title: "Keep the important things close.",
        copy: "Gather starred items from across your workspace in one place.",
        alt: "Nivra Favorites view showing saved items from multiple content sections.",
      },
      {
        id: "account-security",
        label: "Account security",
        title: "Keep your access in your hands.",
        copy: "Review your sign-in methods, recovery options and device notifications.",
        alt: "Nivra Account settings showing sign-in methods, passkeys, recovery and notification controls.",
      },
      {
        id: "mcp",
        label: "MCP",
        title: "Let your tools work with your workspace.",
        copy: "Connect compatible agents with the access you choose for them.",
        alt: "Nivra MCP settings showing the server endpoint, client setup instructions and API-key controls.",
      },
      {
        id: "import-export",
        label: "Import & export",
        title: "Take your workspace with you.",
        copy: "Bring in existing material or export a portable copy of your workspace.",
        alt: "Nivra Import and export settings showing available workspace transfer options.",
      },
      {
        id: "settings-system",
        label: "System settings",
        title: "Choose how your workspace is kept.",
        copy: "Configure storage, backups and upload limits in one place.",
        alt: "Nivra System settings showing storage, backup and upload configuration.",
      },
    ],
  },
];
const connectedFeatures = [
  {
    id: "smart-tags",
    title: "Smart tagging",
    copy:
      "Start with the tags you already use. Match new work to your tags first. " +
      "Review suggestions, or opt into automatic tagging for recurring topics.",
    window: "Tag suggestions",
    alt: "Nivra showing a suggested tag alongside the item it can organize.",
  },
  {
    id: "semantic-search",
    title: "Semantic search",
    copy:
      "Search by the idea you remember. Find related notes and files even when " +
      "your words differ, including OCR and document text.",
    window: "Search",
    alt: "Nivra search results for a natural-language query, showing related workspace items.",
  },
];
const command =
  "docker run -d --name nivra \\\n  --restart unless-stopped --init \\\n  -p 3000:3000 \\\n  -v nivra-data:/data \\\n  ghcr.io/harsh-2002/nivra:latest";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101011"
      media="(prefers-color-scheme: dark)"
    />
    <title>Nivra — Your thoughts, together.</title>
    <meta
      name="description"
      content="A quiet, self-hosted workspace for your notes, journals, tasks, bookmarks and files. Write, plan and keep the things that matter together."
    />
    <link rel="canonical" href="https://harsh-2002.github.io/Nivra/" />
    <link rel="icon" href={asset("icon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      href={asset("fonts/geist-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Nivra — Your thoughts, together." />
    <meta
      property="og:description"
      content="A quiet workspace for your notes, plans and ideas. Open source. Self-hosted. Yours."
    />
    <meta property="og:url" content="https://harsh-2002.github.io/Nivra/" />
    <meta
      property="og:image"
      content="https://harsh-2002.github.io/Nivra/social.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("nivra-site-theme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <main id="main" data-site-base={base}>
      <section class="hero container" aria-labelledby="hero-title">
        <a class="brand hero-brand" href={base} aria-label="Nivra home">
          <img src={asset("icon.svg")} width="30" height="30" alt="" />
          <span>Nivra</span>
        </a>
        <div class="hero-intro">
          <h1 id="hero-title">
            Your thoughts,
            <br />
            together.
          </h1>
          <div class="hero-detail">
            <p>
              A quiet workspace for your notes, plans and ideas. All connected.
              All on your own server.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#start">
                Self-host Nivra
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
              <a class="text-link" href={repository}>
                View on GitHub
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        <figure class="hero-figure">
          <div class="app-window hero-window">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span class="window-label">Nivra / Overview</span>
              <span class="window-spacer"></span>
            </div>
            <picture class="pending-screenshot" data-screenshot-picture>
              <source
                data-mobile-source
                media="(max-width: 600px)"
                sizes="(max-width: 600px) calc(100vw - 48px), 390px"
              />
              <img
                data-screenshot-id="overview"
                sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px"
                width="1440"
                height="900"
                fetchpriority="high"
                alt="Nivra Overview showing a personal field guide project, with open tasks, recent notes and saved references."
              />
            </picture>
            <noscript>
              <picture class="fallback-screenshot">
                <source
                  media="(max-width: 600px) and (prefers-color-scheme: dark)"
                  srcset={`${asset("screenshots/overview-mobile-dark-390.webp")} 390w, ${asset("screenshots/overview-mobile-dark-780.webp")} 780w, ${asset("screenshots/overview-mobile-dark-1170.webp")} 1170w`}
                  sizes="(max-width: 600px) calc(100vw - 48px), 390px"
                />
                <source
                  media="(max-width: 600px)"
                  srcset={`${asset("screenshots/overview-mobile-light-390.webp")} 390w, ${asset("screenshots/overview-mobile-light-780.webp")} 780w, ${asset("screenshots/overview-mobile-light-1170.webp")} 1170w`}
                  sizes="(max-width: 600px) calc(100vw - 48px), 390px"
                />
                <source
                  media="(prefers-color-scheme: dark)"
                  srcset={`${asset("screenshots/overview-desktop-dark-1440.webp")} 1440w, ${asset("screenshots/overview-desktop-dark-2880.webp")} 2880w`}
                  sizes="(max-width: 1219px) calc(100vw - 80px), 1140px"
                />
                <img
                  src={asset("screenshots/overview-desktop-light-1440.webp")}
                  srcset={`${asset("screenshots/overview-desktop-light-1440.webp")} 1440w, ${asset("screenshots/overview-desktop-light-2880.webp")} 2880w`}
                  sizes="(max-width: 1219px) calc(100vw - 80px), 1140px"
                  width="1440"
                  height="900"
                  alt="Nivra Overview showing a personal field guide project, with open tasks, recent notes and saved references."
                />
              </picture>
            </noscript>
          </div>
          <figcaption>
            One place to return to. Real Nivra screens, with demonstration
            content.
          </figcaption>
        </figure>
      </section>
      <section
        class="product container"
        id="product"
        aria-labelledby="product-title"
      >
        <div class="section-intro">
          <h2 id="product-title">
            From a passing thought
            <br />
            to something real.
          </h2>
          <p>
            Write it down. Find the next step.
            <br />
            Keep the context close.
          </p>
        </div>
        <div
          class="workflow-group-tabs"
          role="tablist"
          aria-label="Explore Nivra features"
        >
          {workflowGroups.map((group, i) => (
            <button
              id={`group-tab-${group.id}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls="workflow-group-panel"
              tabindex={i === 0 ? 0 : -1}
              data-workflow-group={group.id}
            >
              {group.label}
            </button>
          ))}
        </div>
        <div
          class="workflow-group-panel"
          id="workflow-group-panel"
          role="tabpanel"
          aria-labelledby="group-tab-write"
        >
          {workflowGroups.map((group, i) => (
            <div
              class="workflow-feature-tabs"
              id={`feature-tabs-${group.id}`}
              role="tablist"
              aria-label={`${group.label} features`}
              hidden={i !== 0}
            >
              {group.features.map((feature, featureIndex) => (
                <button
                  id={`feature-tab-${feature.id}`}
                  type="button"
                  role="tab"
                  aria-selected={featureIndex === 0 ? "true" : "false"}
                  aria-controls="workflow-panel"
                  tabindex={featureIndex === 0 ? 0 : -1}
                  data-workflow-feature={feature.id}
                  data-workflow-group={group.id}
                  data-label={feature.label}
                  data-title={feature.title}
                  data-copy={feature.copy}
                  data-alt={feature.alt}
                >
                  {feature.label}
                </button>
              ))}
            </div>
          ))}
          <div
            class="workflow-panel"
            id="workflow-panel"
            role="tabpanel"
            aria-labelledby="feature-tab-notes"
          >
            <div class="workflow-copy">
              <h3 data-workflow-title>{workflowGroups[0].features[0].title}</h3>
              <p data-workflow-copy>{workflowGroups[0].features[0].copy}</p>
            </div>
            <div class="app-window workflow-window">
              <div class="window-bar" aria-hidden="true">
                <span class="window-dots">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span class="window-label" data-workflow-window-label>
                  Nivra / Notes
                </span>
                <span class="window-spacer"></span>
              </div>
              <a
                class="workflow-image-link"
                data-full-size-id="notes"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open full-size Notes screenshot"
              >
                <picture class="pending-screenshot" data-screenshot-picture>
                  <source
                    data-mobile-source
                    media="(max-width: 600px)"
                    sizes="(max-width: 600px) calc(100vw - 48px), 390px"
                  />
                  <img
                    data-screenshot-id="notes"
                    sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px"
                    width="1440"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    alt={workflowGroups[0].features[0].alt}
                  />
                </picture>
              </a>
            </div>
          </div>
        </div>
      </section>
      <section
        class="connections container"
        id="connections"
        aria-labelledby="connections-title"
      >
        <div class="connections-heading">
          <h2 id="connections-title">Keep the thread.</h2>
          <p>
            Smart tagging and semantic search are previews on main, shown with
            demonstration content.
          </p>
        </div>
        <div class="connections-grid">
          {connectedFeatures.map((feature) => (
            <article class="connection-card">
              <div class="connection-copy workflow-copy">
                <h3>{feature.title}</h3>
                <p>{feature.copy}</p>
              </div>
              <div class="app-window connection-window">
                <div class="window-bar" aria-hidden="true">
                  <span class="window-dots">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                  <span class="window-label">Nivra / {feature.window}</span>
                  <span class="window-spacer"></span>
                </div>
                <a
                  class="connection-image-link"
                  data-full-size-id={feature.id}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open full-size ${feature.title} screenshot`}
                >
                  <picture class="pending-screenshot" data-screenshot-picture>
                    <source
                      data-mobile-source
                      media="(max-width: 600px)"
                      sizes="(max-width: 600px) calc(100vw - 48px), 390px"
                    />
                    <img
                      data-screenshot-id={feature.id}
                      sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px"
                      width="1440"
                      height="900"
                      loading="lazy"
                      decoding="async"
                      alt={feature.alt}
                    />
                  </picture>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        class="workspace-features container"
        aria-labelledby="features-title"
      >
        <h2 id="features-title">Everything has a place.</h2>
        <dl class="feature-list">
          <div>
            <dt>Write and share</dt>
            <dd>
              Notes, journals, drawings and published pages. Save bookmarks,
              screenshots and documents alongside them.
            </dd>
          </div>
          <div>
            <dt>Plan and collect</dt>
            <dd>
              Tasks, Kanban boards and calendar events with reminders. Share
              forms, review responses and restore deleted items.
            </dd>
          </div>
          <div>
            <dt>Find and connect</dt>
            <dd>
              Tags, favorites, smart tagging and semantic search. Connect agents
              with MCP, use the API, or add Nivra to your device.
            </dd>
          </div>
        </dl>
      </section>
      <section
        class="ownership container"
        id="yours"
        aria-labelledby="ownership-title"
      >
        <div>
          <h2 id="ownership-title">
            A workspace
            <br />
            that stays yours.
          </h2>
          <p>
            Open source, self-hosted, and built for one person.
            <br class="desktop-break" /> A little less noise. A little more room
            to think.
          </p>
        </div>
        <dl class="ownership-list">
          <div>
            <dt>Your server. Your choice.</dt>
            <dd>
              Store files locally or in S3. Choose encryption at rest during
              setup.
            </dd>
          </div>
          <div>
            <dt>Bring your tools along.</dt>
            <dd>
              Connect an AI agent through MCP, with read or read and write
              access.
            </dd>
          </div>
          <div>
            <dt>Keep a way out.</dt>
            <dd>
              Export your work and take full backups. Your workspace is yours to
              keep.
            </dd>
          </div>
        </dl>
      </section>
      <section class="start container" id="start" aria-labelledby="start-title">
        <div class="start-copy">
          <h2 id="start-title">
            Make yourself
            <br />
            some space.
          </h2>
          <p>
            This command is for the updated image after release. Until then,
            follow the source-build instructions in the quick start.
          </p>
          <a class="text-link" href={`${repository}#get-started-with-docker`}>
            Read the quick start
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
        <div class="install">
          <div class="install-heading">
            <span>Docker quick start</span>
            <button
              class="icon-button copy-button"
              type="button"
              aria-label="Copy Docker quick start"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <rect x="8" y="8" width="12" height="12" rx="2" />
                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
              </svg>
            </button>
          </div>
          <pre
            tabindex="0"
            aria-label="Docker installation commands"
          ><code id="install-command">{command}</code></pre>
          <div class="install-footer">
            <span>
              Open <code>localhost:3000</code> to set up your workspace.
            </span>
            <span id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer container">
      <div class="footer-links">
        <a href={repository}>GitHub</a>
        <a href={`${repository}/blob/main/LICENSE`}>MIT license</a>
      </div>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch theme"
      >
        <svg class="moon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" />
        </svg>
        <svg class="sun" aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </footer>
    <script>
      const root = document.documentElement;
      const screenshotViewport = window.matchMedia("(max-width: 600px)");
      const preference = window.matchMedia("(prefers-color-scheme: dark)");
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === "dark" : preference.matches;
      const siteBase =
        document.querySelector<HTMLElement>("#main")?.dataset.siteBase ?? "/";
      const screenshotUrl = (
        id: string,
        device: "desktop" | "mobile",
        theme: "light" | "dark",
        width: number,
      ) => `${siteBase}screenshots/${id}-${device}-${theme}-${width}.webp`;
      for (const picture of document.querySelectorAll<HTMLPictureElement>(
        ".pending-screenshot",
      )) {
        const img = picture.querySelector<HTMLImageElement>("img");
        if (!img) continue;
        img.addEventListener("load", () => {
          const expected = img.dataset.expectedScreenshot;
          if (expected && img.currentSrc.includes(expected))
            picture.classList.add("is-ready");
        });
        img.addEventListener("error", () =>
          picture.classList.remove("is-ready"),
        );
      }
      const refreshScreenshots = () => {
        const theme = isDark() ? "dark" : "light";
        const mobile = screenshotViewport.matches;
        for (const picture of document.querySelectorAll<HTMLPictureElement>(
          "[data-screenshot-picture]",
        )) {
          const img = picture.querySelector<HTMLImageElement>(
            "img[data-screenshot-id]",
          );
          if (!img) continue;
          const id = img.dataset.screenshotId;
          if (!id) continue;
          const device = mobile ? "mobile" : "desktop";
          const selected = `${id}-${device}-${theme}-`;
          picture.classList.remove("is-ready");
          img.dataset.expectedScreenshot = selected;
          const source = picture.querySelector<HTMLSourceElement>(
            "source[data-mobile-source]",
          );
          if (source) {
            source.srcset = [390, 780, 1170]
              .map(
                (width) =>
                  `${screenshotUrl(id, "mobile", theme, width)} ${width}w`,
              )
              .join(", ");
            source.sizes = "(max-width: 600px) calc(100vw - 48px), 390px";
          }
          img.srcset = [1440, 2880]
            .map(
              (width) =>
                `${screenshotUrl(id, "desktop", theme, width)} ${width}w`,
            )
            .join(", ");
          img.sizes =
            "(max-width: 600px) calc(100vw - 48px), (max-width: 1000px) calc(100vw - 48px), (max-width: 1219px) calc(100vw - 80px), 1140px";
          img.src = screenshotUrl(id, "desktop", theme, 1440);
          const fullSizeLink = picture.closest<HTMLAnchorElement>(
            "[data-full-size-id]",
          );
          if (fullSizeLink)
            fullSizeLink.href = screenshotUrl(
              id,
              mobile ? "mobile" : "desktop",
              theme,
              mobile ? 1170 : 2880,
            );
          if (
            img.complete &&
            img.naturalWidth > 0 &&
            img.currentSrc.includes(selected)
          )
            picture.classList.add("is-ready");
        }
      };
      refreshScreenshots();
      screenshotViewport.addEventListener("change", refreshScreenshots);
      const refreshThemeLabel = () =>
        document
          .querySelector(".theme-toggle")
          ?.setAttribute(
            "aria-label",
            `Switch to ${isDark() ? "light" : "dark"} theme`,
          );
      refreshThemeLabel();
      preference.addEventListener("change", refreshThemeLabel);
      preference.addEventListener("change", refreshScreenshots);
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        root.dataset.theme = isDark() ? "light" : "dark";
        try {
          localStorage.setItem("nivra-site-theme", root.dataset.theme);
        } catch {}
        refreshThemeLabel();
        refreshScreenshots();
      });
      const groupTabs = [
        ...document.querySelectorAll<HTMLButtonElement>(
          ".workflow-group-tabs [data-workflow-group]",
        ),
      ];
      const featureTabs = [
        ...document.querySelectorAll<HTMLButtonElement>(
          "[data-workflow-feature]",
        ),
      ];
      const groupPanel = document.querySelector<HTMLElement>(
        "#workflow-group-panel",
      );
      const workflowPanel =
        document.querySelector<HTMLElement>("#workflow-panel");
      const selectedFeatures = new Map<string, string>();
      for (const tab of featureTabs)
        if (tab.getAttribute("aria-selected") === "true")
          selectedFeatures.set(
            tab.dataset.workflowGroup ?? "",
            tab.dataset.workflowFeature ?? "",
          );

      function activateFeature(tab: HTMLButtonElement) {
        const group = tab.dataset.workflowGroup ?? "write";
        const features = featureTabs.filter(
          (item) => item.dataset.workflowGroup === group,
        );
        for (const item of features) {
          const active = item === tab;
          item.setAttribute("aria-selected", String(active));
          item.tabIndex = active ? 0 : -1;
        }
        selectedFeatures.set(group, tab.dataset.workflowFeature ?? "");
        workflowPanel?.setAttribute("aria-labelledby", tab.id);
        const title = document.querySelector<HTMLElement>(
          "[data-workflow-title]",
        );
        const copy = document.querySelector<HTMLElement>(
          "[data-workflow-copy]",
        );
        const windowLabel = document.querySelector<HTMLElement>(
          "[data-workflow-window-label]",
        );
        if (title)
          title.textContent = tab.dataset.title ?? tab.textContent ?? "";
        if (copy) copy.textContent = tab.dataset.copy ?? "";
        if (windowLabel)
          windowLabel.textContent = `Nivra / ${tab.dataset.label ?? tab.textContent ?? ""}`;
        const img = workflowPanel?.querySelector<HTMLImageElement>(
          "img[data-screenshot-id]",
        );
        if (img) {
          img.dataset.screenshotId = tab.dataset.workflowFeature ?? "";
          img.alt = tab.dataset.alt ?? "";
          const link = img.closest<HTMLAnchorElement>("[data-full-size-id]");
          if (link) {
            link.dataset.fullSizeId = tab.dataset.workflowFeature ?? "";
            link.setAttribute(
              "aria-label",
              `Open full-size ${tab.dataset.label ?? "workspace"} screenshot`,
            );
          }
        }
        refreshScreenshots();
      }

      function activateGroup(tab: HTMLButtonElement) {
        const group = tab.dataset.workflowGroup ?? "write";
        for (const item of groupTabs) {
          const active = item === tab;
          item.setAttribute("aria-selected", String(active));
          item.tabIndex = active ? 0 : -1;
        }
        groupPanel?.setAttribute("aria-labelledby", tab.id);
        for (const list of document.querySelectorAll<HTMLElement>(
          ".workflow-feature-tabs",
        ))
          list.hidden = list.id !== `feature-tabs-${group}`;
        const features = featureTabs.filter(
          (item) => item.dataset.workflowGroup === group,
        );
        const selectedId = selectedFeatures.get(group);
        const selected =
          features.find(
            (item) => item.dataset.workflowFeature === selectedId,
          ) ?? features[0];
        if (selected) activateFeature(selected);
      }

      function handleTabKeys(
        event: KeyboardEvent,
        tab: HTMLButtonElement,
        tabs: HTMLButtonElement[],
        activate: (target: HTMLButtonElement) => void,
      ) {
        const index = tabs.indexOf(tab);
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft")
          next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        const target = tabs[next];
        activate(target);
        target.focus();
      }

      for (const tab of groupTabs) {
        tab.addEventListener("click", () => activateGroup(tab));
        tab.addEventListener("keydown", (event) =>
          handleTabKeys(event, tab, groupTabs, activateGroup),
        );
      }
      for (const tab of featureTabs) {
        tab.addEventListener("click", () => activateFeature(tab));
        tab.addEventListener("keydown", (event) => {
          const list = tab.closest<HTMLElement>(".workflow-feature-tabs");
          if (!list) return;
          const listTabs = [
            ...list.querySelectorAll<HTMLButtonElement>(
              "[data-workflow-feature]",
            ),
          ];
          handleTabKeys(event, tab, listTabs, activateFeature);
        });
      }
      document
        .querySelector(".copy-button")
        ?.addEventListener("click", async () => {
          const content =
            document.querySelector("#install-command")?.textContent;
          const status = document.querySelector("#copy-status");
          if (!content || !status) return;
          try {
            await navigator.clipboard.writeText(content);
            status.textContent = "Copied";
          } catch {
            status.textContent = "Select and copy the commands above.";
          }
        });
    </script>
  </body>
</html>

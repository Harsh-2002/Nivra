{
  "manifest_version": 3,
  "name": "Nivra",
  "short_name": "Nivra",
  "description": "Save the current page to your self-hosted Nivra instance in one click, then add a title, collection, tags or a note.",
  "version": "2026.10.15",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Nivra",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "permissions": ["activeTab", "storage", "contextMenus", "identity"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to Nivra"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
